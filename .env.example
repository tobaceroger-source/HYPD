# Copie para .env. Nunca coloque segredos no frontend ou no Git.
PORT=4317
HOST=127.0.0.1
APP_URL=http://localhost:4317
# demo funciona sem credenciais. live exige ADMIN_PASSWORD e APP_SECRET.
APP_MODE=demo
ADMIN_PASSWORD=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v26
# Google Cloud: redirect URI http://localhost:4317/api/oauth/google_ads/callback
# e http://localhost:4317/api/oauth/ga4/callback
# Ative Google Ads API, Analytics Admin API e Analytics Data API.

META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v27.0
# Se seu app usa Facebook Login for Business, informe a configuração publicada.
META_LOGIN_CONFIG_ID=
# Redirect URI http://localhost:4317/api/oauth/meta/callback

# A IA recebe métricas agregadas do cliente selecionado.
# Chave própria de API; assinatura ChatGPT não substitui créditos de API.
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini
# Alternativa: AI Gateway, sem OPENAI_API_KEY.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
